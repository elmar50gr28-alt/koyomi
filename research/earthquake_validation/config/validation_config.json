      {"id": "turkey", "label": "Turkey region", "latitude": 38.0, "longitude": 37.0}
    ],
    "topPeriodsPerRegion": 4,
    "lowPeriodsPerRegion": 2,
    "minMagnitudeForMajor": 6.5
  },
  "safetyLanguage": {
    "forbiddenLabels": ["地震発生確率", "地震予知", "日時指定地震予測", "安全宣言", "独自警報"],
    "researchLabel": "研究用地震活動指標"
  }
}
